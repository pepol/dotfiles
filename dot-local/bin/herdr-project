#!/usr/bin/env python3
"""Open a project as a herdr workspace laid out for editor-plus-agent work.

    herdr-project <branch> [--kind claude] [--base main] [--repo PATH]

Creates a git worktree for <branch>, gives it a herdr workspace, and splits
that workspace into the two panes the rest of this setup assumes:

    +----------------------+----------------------+
    |  Neovim              |  agent               |
    |  (owns the workspace |  (or a plain shell)  |
    |   editor socket)     |                      |
    +----------------------+----------------------+

The left pane starts Neovim through herdr-nvim, so it claims the workspace's
editor socket. From then on anything in the right pane that wants an editor --
`git commit`, an agent opening a file, prefix+e -- lands in that same Neovim.

The worktree is placed under the repository's own parent directory rather
than herdr's default worktree root, because the per-directory identity rules
in ~/.gitconfig match on gitdir: a checkout under ~/src/corp keeps the corp
name and email, one under ~/src/personal keeps the personal ones, and a
checkout under a single global worktree root would silently get whichever of
the two the top-level [user] block names.
"""

import argparse
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.expanduser("~/.local/lib/herdr"))
import herdr_ipc  # noqa: E402


def herdr(*args):
    """Run a herdr CLI command and return its parsed result."""
    import json

    proc = subprocess.run(
        ["herdr", *args], stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    if proc.returncode != 0:
        raise SystemExit(
            "herdr %s failed: %s"
            % (" ".join(args), proc.stderr.decode().strip() or proc.returncode)
        )
    return json.loads(proc.stdout.decode())["result"]


def main():
    parser = argparse.ArgumentParser(
        description="Open a git branch as a herdr workspace with Neovim and an agent."
    )
    parser.add_argument("branch", help="branch to create and check out")
    parser.add_argument("--base", help="branch to fork from (default: repo default)")
    parser.add_argument(
        "--kind",
        help="agent to start in the right pane; omit for a plain shell",
    )
    parser.add_argument(
        "--repo",
        default=os.getcwd(),
        help="repository to make the worktree from (default: cwd)",
    )
    args = parser.parse_args()

    if not herdr_ipc.in_herdr():
        # The workspace would be created on a server the user is not looking
        # at, which is never what they meant.
        raise SystemExit("herdr-project: run this from inside a herdr pane")

    repo = os.path.abspath(args.repo)
    toplevel = subprocess.run(
        ["git", "-C", repo, "rev-parse", "--show-toplevel"],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    if toplevel.returncode != 0:
        raise SystemExit("herdr-project: %s is not a git repository" % repo)
    toplevel = toplevel.stdout.decode().strip()

    # Sibling of the repo, under a dot-directory so it does not look like
    # another checkout. Slashes in a branch name become directories, which
    # `git worktree add` is fine with.
    path = os.path.join(
        os.path.dirname(toplevel),
        ".worktrees",
        os.path.basename(toplevel),
        args.branch,
    )

    create = ["worktree", "create", "--cwd", toplevel, "--path", path,
              "--branch", args.branch, "--label", args.branch, "--focus"]
    if args.base:
        create += ["--base", args.base]

    result = herdr(*create)
    workspace = result["workspace"]["workspace_id"]
    editor_pane = result["root_pane"]["pane_id"]
    cwd = result["root_pane"].get("cwd") or path

    # The agent sits to the right; the editor keeps focus so the workspace
    # opens on the code rather than on a prompt.
    agent_pane = herdr(
        "pane", "split", editor_pane, "--direction", "right",
        "--cwd", cwd, "--no-focus",
    )["pane"]["pane_id"]

    # herdr-nvim rather than nvim: it is what claims the workspace editor
    # socket and records which pane holds it.
    herdr("pane", "run", editor_pane, "herdr-nvim .")

    if args.kind:
        # agent start needs the pane sitting at an interactive prompt, and the
        # split's shell has only just been spawned.
        time.sleep(1)
        name = args.branch.replace("/", "-")[:32]
        try:
            herdr("agent", "start", name, "--kind", args.kind, "--pane", agent_pane)
        except SystemExit as err:
            # A missing agent binary should not cost you the workspace.
            print(err, file=sys.stderr)

    print("workspace %s (%s)" % (workspace, args.branch))
    print("  editor %s   agent %s" % (editor_pane, agent_pane))
    print("  worktree %s" % cwd)


if __name__ == "__main__":
    main()
