#!/usr/bin/env python3
"""Mirror herdr's positional indexes into sidebar tokens.

Herdr's sidebar row templates have no built-in token for the index that
`switch_workspace` (prefix+shift+1..9) and `focus_agent` (prefix+ctrl+1..9)
jump to, so the numbers have to be fed in as custom metadata. This reports
each workspace's positional `number` and each agent row's panel position as
the `$n` token consumed by [ui.sidebar.spaces] and [ui.sidebar.agents].

Only 1..9 are reported, since higher positions have no keybinding.

Usage: herdr-sidebar-numbers --once | --watch
"""

import os
import sys
import threading
import time

sys.path.insert(0, os.path.expanduser("~/.local/lib/herdr"))
import herdr_ipc  # noqa: E402

SOURCE = "sidebar-numbers"
MAX = 9

# Our own writes emit workspace.metadata_updated / pane.updated, so those are
# deliberately absent here: subscribing to them would loop.
EVENTS = [
    "workspace.created",
    "workspace.closed",
    "workspace.moved",
    "workspace.reordered",
    "pane.agent_detected",
    "pane.closed",
    "pane.exited",
    "pane.moved",
]


def number_token(index):
    """Positions past the last keybinding get no number rather than a lie."""
    return str(index) if 1 <= index <= MAX else None


def renumber():
    for space in herdr_ipc.request("workspace.list")["workspaces"]:
        herdr_ipc.request(
            "workspace.report_metadata",
            {
                "workspace_id": space["workspace_id"],
                "source": SOURCE,
                "tokens": {"n": number_token(space["number"])},
            },
            client_id=SOURCE,
        )

    # Agent panel order under the default agent_panel_sort = "spaces": grouped
    # by workspace, then tab, then pane -- the order agent.list already returns.
    for index, agent in enumerate(herdr_ipc.request("agent.list")["agents"], start=1):
        herdr_ipc.request(
            "pane.report_metadata",
            {
                "pane_id": agent["pane_id"],
                "source": SOURCE,
                "tokens": {"n": number_token(index)},
            },
            client_id=SOURCE,
        )


def watch():
    """Renumber on topology changes, coalescing bursts into one pass.

    The event stream needs a connection held open, which is the one thing the
    shared single-request client does not do, so this speaks the protocol
    directly.
    """
    import json
    import socket

    pending = threading.Event()

    def apply_loop():
        while True:
            pending.wait()
            # Let a burst (a workspace closing takes its panes with it) settle
            # into one renumber rather than one per event.
            time.sleep(0.2)
            pending.clear()
            try:
                renumber()
            except (herdr_ipc.HerdrError, OSError) as err:
                print("renumber failed: %s" % err, file=sys.stderr)

    threading.Thread(target=apply_loop, daemon=True).start()

    while True:
        try:
            with socket.socket(socket.AF_UNIX) as sock:
                sock.connect(herdr_ipc.socket_path())
                with sock.makefile("rwb") as stream:
                    stream.write(
                        (
                            json.dumps(
                                {
                                    "id": SOURCE,
                                    "method": "events.subscribe",
                                    "params": {
                                        "subscriptions": [
                                            {"type": event} for event in EVENTS
                                        ]
                                    },
                                }
                            )
                            + "\n"
                        ).encode()
                    )
                    stream.flush()
                    stream.readline()  # subscription_started

                    # Subscribing replays a backlog of past events; renumber
                    # once from live state instead of acting on each replay.
                    renumber()

                    for _ in stream:
                        pending.set()
        except (OSError, ValueError, KeyError, herdr_ipc.HerdrError) as err:
            print("reconnecting after: %s" % err, file=sys.stderr)
        time.sleep(2)


def main():
    mode = sys.argv[1] if len(sys.argv) == 2 else ""
    if mode == "--once":
        renumber()
    elif mode == "--watch":
        watch()
    else:
        print("usage: herdr-sidebar-numbers --once | --watch", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
