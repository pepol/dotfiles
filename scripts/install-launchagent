#!/usr/bin/env bash
# Render and load the launch agent that keeps the herdr sidebar numbered.
#
# The numbers are what make prefix+shift+1..9 (workspaces) and prefix+ctrl+1..9
# (agents) legible: herdr has no built-in token for the positional index those
# keys jump to, so a watcher reports it as metadata. Without this the number
# column in the sidebar is blank and the bindings still work but are blind.
set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "$0")/.." && pwd)}"
LABEL=dev.herdr.sidebar-numbers
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

if [ "$(uname -s)" != "Darwin" ]; then
	echo "launchagent: not macOS, skipping"
	echo "launchagent: run 'herdr-sidebar-numbers --watch' from your own supervisor"
	exit 0
fi

# herdr-sidebar-numbers shells out to python3 only; the PATH here just needs
# herdr itself, which mise shims into ~/.local/share/mise/shims.
AGENT_PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
sed -e "s|@HOME@|$HOME|g" -e "s|@PATH@|$AGENT_PATH|g" \
	"$DOTFILES/templates/$LABEL.plist.in" >"$PLIST"

# bootout first so a re-run picks up an edited plist; it fails when nothing is
# loaded, which is fine on a first install.
launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$PLIST"

echo "launchagent: loaded $LABEL"
echo "launchagent: logs at $HOME/Library/Logs/herdr-sidebar-numbers.log"
