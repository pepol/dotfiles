#!/usr/bin/env bash
# Check that the pieces of the workflow can actually see each other.
# Exits non-zero if something that should work will not.
set -uo pipefail

fail=0
ok()   { printf '  \033[32mok\033[0m   %s\n' "$1"; }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$1"; fail=1; }
note() { printf '  --   %s\n' "$1"; }

have() { command -v "$1" >/dev/null 2>&1; }

echo "tools"
for tool in nvim herdr git; do
	if have "$tool"; then ok "$tool ($(command -v "$tool"))"; else bad "$tool not on PATH"; fi
done

if have nvim; then
	version=$(nvim --version | head -1 | sed 's/^NVIM v//')
	case "$version" in
		0.1[2-9]*|0.[2-9]*|[1-9]*) ok "neovim $version" ;;
		*) bad "neovim $version is too old; this config needs 0.12" ;;
	esac
fi

echo
echo "environment"
# Telescope shells out to these: ripgrep is required for live_grep, fd is the
# preferred file finder. Both come from the global mise config.
for tool in rg fd; do
	if have "$tool"; then ok "$tool"; else bad "$tool not on PATH (mise run tools)"; fi
done
for script in herdr-sidebar-numbers tf-file; do
	if have "$script"; then ok "$script"; else bad "$script not on PATH (mise run link)"; fi
done
case "${EDITOR:-}" in
	*nvim) ok "\$EDITOR is $EDITOR" ;;
	"") bad "\$EDITOR is unset; open a new shell so .zshrc applies" ;;
	*) bad "\$EDITOR is $EDITOR, expected nvim" ;;
esac

echo
echo "neovim config"
if have nvim; then
	if nvim --headless "+lua vim.cmd('qa')" +qa 2>&1 | grep -qiE '^E[0-9]+|error'; then
		bad "config raises errors on startup; run: nvim --headless +qa"
	else
		ok "config loads without errors"
	fi
	for plugin in herdr-splits.nvim herdr-context.nvim; do
		if [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy/$plugin" ]; then
			ok "$plugin installed"
		else
			bad "$plugin not installed (mise run nvim-sync, inside a herdr pane)"
		fi
	done
	# The one plugin with a compile step, so the one that can be installed
	# but not working. Without it telescope falls back to the Lua sorter.
	fzf_native="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy/telescope-fzf-native.nvim/build"
	if [ -f "$fzf_native/libfzf.so" ] || [ -f "$fzf_native/libfzf.dylib" ]; then
		ok "telescope-fzf-native built"
	else
		bad "telescope-fzf-native not built (nvim -c 'Lazy build telescope-fzf-native.nvim')"
		note "needs make and a C compiler: xcode-select --install"
	fi
fi

echo
echo "herdr"
if [ "${HERDR_ENV:-}" = 1 ]; then
	ok "running inside a herdr pane (workspace ${HERDR_WORKSPACE_ID:-?})"
	# The herdr half of each Neovim plugin. Without it the plugin_action
	# keybindings in herdr/config.toml resolve to nothing.
	for plugin in herdr-splits herdr-context; do
		if herdr plugin list 2>/dev/null | grep -q "^- $plugin "; then
			ok "$plugin herdr plugin installed"
		else
			bad "$plugin herdr plugin missing (mise run herdr-setup)"
		fi
	done
	# Every plugin_action the config binds has to resolve to a registered
	# action, or that key silently does nothing.
	actions=$(herdr plugin action list 2>/dev/null |
		sed 's/[{,]/\n/g' | sed -n 's/.*"action_id":"\([^"]*\)".*/\1/p')
	plugin_ids=$(herdr plugin action list 2>/dev/null |
		sed 's/[{,]/\n/g' | sed -n 's/.*"plugin_id":"\([^"]*\)".*/\1/p')
	missing=0
	while IFS= read -r bound; do
		[ -n "$bound" ] || continue
		want_plugin=${bound%%.*}
		want_action=${bound#*.}
		if ! printf '%s\n' "$actions" | grep -qx "$want_action" ||
		   ! printf '%s\n' "$plugin_ids" | grep -qx "$want_plugin"; then
			bad "keybinding refers to unknown action $bound"
			missing=1
		fi
	done <<-BOUND
		$(sed -n 's/^command = "\([a-z-]*\.[a-z-]*\)"$/\1/p' \
			"${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml" 2>/dev/null)
	BOUND
	[ "$missing" -eq 0 ] && ok "every plugin_action keybinding resolves"
else
	note "not inside a herdr pane; skipping the herdr plugin checks"
fi

echo
if [ "$fail" -eq 0 ]; then
	echo "everything checks out."
else
	echo "some checks failed; see above."
fi
exit "$fail"
